{
  "name": "@better-router/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    },
    "./index": null
  },
  "scripts": {
    "build": "yarn --cwd ../.. tsdown -F core",
    "check": "tsc -b --pretty false"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "effect": "4.0.0-rc.117"
  }
}
